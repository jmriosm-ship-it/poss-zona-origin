{
    "name": "zona-originals-poo",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Punto de venta de Zona Originals",
    "author": "Zona Originals",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "escritorio": "vite build && electron .",
        "instalador": "vite build && electron-builder --win"
    },
    "build": {
        "appId": "co.zonaoriginals.pos",
        "productName": "Zona Originals POS",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "public/logo.png",
            "package.json"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        }
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.118.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^45.1.0",
        "electron-builder": "^26.18.0",
        "vite": "^8.3.0"
    }
}
